# Initial admin password is built in; change it in My Account after login.
DEPLOYER_LISTEN=127.0.0.1:7710
DEPLOYER_DATA=/data/deployer/controller
# Mandatory TLS server identity and the CA trusted to issue Agent certificates.
DEPLOYER_TLS_CERT=/data/deployer/config/server-cert.pem
DEPLOYER_TLS_KEY=/data/deployer/config/server-key.pem
DEPLOYER_CLIENT_CA=/data/deployer/config/ca.pem
# Optional loopback-only HTTP console; Agent APIs are unavailable here.
DEPLOYER_UI_LISTEN=

# Optional signed Agent release verification key (base64 Ed25519 public key).
DEPLOYER_UPDATE_PUBLIC_KEY=/data/deployer/config/update-public.key
