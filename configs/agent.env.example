DEPLOYER_SERVER=https://18.138.124.233:7710
DEPLOYER_DATA=/data/deployer/agent
DEPLOYER_NODE_NAME=
# Mutual TLS is mandatory. The URI SAN contains the stable node identity.
DEPLOYER_CA=/data/deployer/config/ca.pem
DEPLOYER_CLIENT_CERT=/data/deployer/config/client-cert.pem
DEPLOYER_CLIENT_KEY=/data/deployer/config/client-key.pem

# Automatic updates require config/update-public.key under the installation root.
# The signing private key must never be installed on this host.
